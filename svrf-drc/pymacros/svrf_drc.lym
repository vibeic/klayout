<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>SVRF-native DRC (vibeic) — read a Calibre/SVRF deck and run it on KLayout's own engine</description>
 <version>0.1.0</version>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc>Registers an in-KLayout SVRF interpreter: KLayout reads a Calibre/SVRF-format
DRC deck (.rule) and executes every rule DIRECTLY on its own DRC engine
(pya.Region.*_check + LayoutToNetlist). No transcoder, no intermediate .drc file.

Batch:  klayout -b -r svrf_klayout/run_svrf_drc.py -rd root=&lt;svrf-drc&gt; \
                 -rd deck=&lt;deck.rule&gt; -rd layout=&lt;in.gds&gt; -rd report=&lt;out.txt&gt;
GUI:    Tools -&gt; SVRF-native DRC…</doc>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <shortcut/>
 <show-in-menu>true</show-in-menu>
 <group-name/>
 <menu-path>tools_menu.end</menu-path>
 <interpreter>python</interpreter>
 <text>import os
import sys

# this .lym lives in &lt;svrf-drc&gt;/pymacros/ ; add &lt;svrf-drc&gt; to the path so the
# svrf_klayout package (the interpreter) is importable inside KLayout.
_SVRF_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _SVRF_ROOT not in sys.path:
    sys.path.insert(0, _SVRF_ROOT)


def run_svrf_deck(deck_path, layout_path, report_path=None):
    """Programmatic entry: read an SVRF deck, run it natively, return the report text."""
    from svrf_klayout.run_svrf_drc import Engine
    eng = Engine(layout_path, open(deck_path, encoding="utf-8", errors="replace").read())
    rows = []
    for r in eng.deck.rules:
        verdict, info = eng.run_rule(r)
        rows.append((verdict, r.name, r.op, info))
    text = "\n".join(f"{v:5s} {n:16s} {op} -> {i}" for v, n, op, i in rows) + "\n"
    if report_path:
        open(report_path, "w").write(text)
    return text


# GUI menu action (best-effort; harmless in batch where there is no main window)
try:
    import pya
    mw = pya.Application.instance().main_window() if pya.Application.instance() else None
    if mw is not None:
        def _on_triggered():
            deck = pya.FileDialog.ask_open_file_name("Select SVRF/Calibre deck", "", "Rule decks (*.rule *.svrf *.drc);;All (*)")
            if not deck:
                return
            gds = pya.FileDialog.ask_open_file_name("Select layout", "", "Layouts (*.gds *.oas);;All (*)")
            if not gds:
                return
            pya.MessageBox.info("SVRF-native DRC", run_svrf_deck(deck, gds), pya.MessageBox.Ok)
        action = pya.Action()
        action.title = "SVRF-native DRC…"
        action.on_triggered = _on_triggered
        mw.menu().insert_item("tools_menu.end", "svrf_native_drc", action)
except Exception:
    pass
</text>
</klayout-macro>
